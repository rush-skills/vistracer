{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisTracer",
  "version": "1.0.0",
  "identifier": "in.anks.vistracer",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "title": "VisTracer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' vistiles: http://vistiles.localhost",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost vistiles: http://vistiles.localhost data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' vistiles: http://vistiles.localhost",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost vistiles: http://vistiles.localhost data: ws://localhost:5173 http://localhost:5173",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../assets/logo.png"
    ],
    "macOS": {
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        }
      }
    },
    "linux": {
      "deb": {
        "depends": ["traceroute"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzQUVFNUFGNDgzNEM3NTEKUldSUnh6UklyK1d1c3hDK05taCtwVDVSaDNLUUpwQzVMWTFFK0dDN0pOdHlOUHhwOXJ0UDMrbkcK",
      "endpoints": [
        "https://github.com/rush-skills/vistracer/releases/latest/download/latest.json"
      ]
    }
  }
}
