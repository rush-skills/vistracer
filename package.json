{
  "name": "vistracer",
  "version": "1.0.0",
  "description": "Tauri-based visual traceroute application rendering hop paths on a 3D globe.",
  "private": true,
  "type": "module",
  "author": {
    "name": "Ankur Singh",
    "email": "hello@anks.in"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rush-skills/vistracer.git"
  },
  "bugs": {
    "url": "https://github.com/rush-skills/vistracer/issues"
  },
  "homepage": "https://vistracer.anks.in",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:renderer": "vite --config vite.config.ts",
    "build": "npm run build:renderer",
    "build:renderer": "tsc -p tsconfig.renderer.json && vite build --config vite.config.ts",
    "tauri": "npx tauri",
    "tauri:dev": "npx tauri dev",
    "tauri:build": "npx tauri build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "cesium": "~1.146.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "satellite.js": "~7.1.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.4.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^17.13.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
